# 是否需要登录验证（服务端以 REQUIRE_AUTH 为准；客户端用 NEXT_PUBLIC_REQUIRE_AUTH 决定是否显示登录页，两者保持一致）
REQUIRE_AUTH=true
NEXT_PUBLIC_REQUIRE_AUTH=true

# 访问口令（仅服务端读取，切勿使用 NEXT_PUBLIC_ 前缀、切勿提交真实值到仓库）
FAMILY_PASSWORD=请改成强口令
# 令牌签名密钥（仅服务端读取，可用 openssl rand -hex 32 生成）
AUTH_SECRET=请改成随机长字符串

# 姓氏配置（用于网站标题、描述和页脚）
NEXT_PUBLIC_FAMILY_NAME=白
# 应用端口号配置
PORT=3000

# 谷歌统计ID (GA4，可选)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
