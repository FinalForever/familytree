# ============================================================
# 族谱网站 · 环境变量配置示例
#
# 用法：把这个文件复制一份、改名叫 .env，然后把下面标了
# 【必填】的值换成你自己的，最后 docker compose up -d 启动。
# 复制命令：cp .env.local.example .env
#
# 注意：.env 里是密钥，不要提交到 git、不要发给别人。
# ============================================================

# 【必填】会话签名密钥：给登录会话签名用，必须至少 16 位，越长越安全。
# 生成一条现成的：打开终端运行  openssl rand -hex 32  ，把结果粘过来。
# 警告：不要用这里的示例值直接上线，那样等于没设防。
AUTH_SECRET=请换成你的随机长字符串

# 【必填】管理后台口令：部署完打开 http://你的地址/admin 就用它登录，
# 在后台里建查看账号、改家族姓氏、开关注册。不填这一项，后台就登不进去。
ADMIN_PASSWORD=请换成你的管理员口令

# 【选填】是否开放前台注册：
#   true  = 任何人都能自己注册账号（默认，适合先让家人自助注册）
#   false = 强制关闭注册，只能由管理员在后台建账号
# 也可以之后在管理后台里开关；但这里一旦设为 false，后台的开关会被压过、以这里为准。
REGISTRATION_OPEN=true

# 【选填】是否必须登录才能看族谱：保持 true 即可。
# 改成 false 等于把族谱公开给所有人，不要改。
REQUIRE_AUTH=true

# ============================================================
# 以下几项是「构建时」变量：只有本地开发（npm run dev）或
# 自行构建镜像时才起作用；用官方预构建镜像部署可以不管，
# 保持默认即可。
# ============================================================

# 客户端是否显示登录页，需与上面的 REQUIRE_AUTH 保持一致
NEXT_PUBLIC_REQUIRE_AUTH=true
# 构建镜像时写入的默认家族姓氏（部署后在管理后台改姓氏即时生效，不用重构建）
NEXT_PUBLIC_FAMILY_NAME=白
# 应用端口（容器内固定 3000，一般不用改；对外端口在 docker-compose.yml 里改）
PORT=3000
# 谷歌统计 GA4 的 ID（没有就留空）
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
